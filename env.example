# Copy to `.env` in the repository root: `cp env.example .env`. Compose reads that file
# automatically. `.env` is listed in .gitignore — never commit one that holds a real key.

# --- required by docker-compose.yml -------------------------------------------

# Absolute path to the directory of documents to index. Mounted read-only at
# /home/datashare/data. Compose refuses to start when this is unset, and refuses to
# invent the directory when the path is wrong (`create_host_path: false`), because an
# empty auto-created mount would start a healthy-looking instance that serves nothing.
DATASHARE_DATA_DIR=/absolute/path/to/your/corpus

# Datashare project (index) name. It must match the project you register on the instance
# and the `project` argument you pass to the MCP server's tools. Defaults to `demo`.
DATASHARE_PROJECT=demo

# --- read by the MCP server, not by compose -----------------------------------
#
# Only omp autoloads this file into the environment of its MCP children. Every other
# client (Claude Code, Claude Desktop, opencode) needs these exported from your shell or
# set in that client's own MCP entry — see "Where to put them" in README.md.
#
# DATASHARE_URL=http://localhost:8888
# DATASHARE_API_KEY=

# Never set COMPOSE_PROFILES=tools here. It would arm the one-shot ingest and apikey
# services for every later command, including a plain `docker compose up -d`.
